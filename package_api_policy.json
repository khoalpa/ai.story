{
  "policy_version": 1,
  "packages": {
    "audio": {
      "stable_public_modules": [
        "audio", "audio.__main__", "audio.cli", "audio.doctor", "audio.entrypoints",
        "audio.app_api", "audio.gui_entry", "audio.gui", "audio.render_audio_app",
        "audio.app_config", "audio.profile_config", "audio.tts_provider", "audio.voice_catalog"
      ],
      "allowed_root_modules": [
        "app_api", "app_config", "asset_profile_utils", "audio_story_spec", "bgm_config_schema",
        "bgm_config_utils", "canonical_to_plain_script", "cli", "cli_utils", "doctor",
        "entrypoints", "exceptions", "gui_entry", "logging_utils", "make_audio_edge_tts",
        "media_test_utils", "paths", "profile_config", "profile_manifest_schema",
        "raw_to_plain_script", "render_audio_app", "render_batch_manifest", "render_batch_runner",
        "render_cli_adapter", "render_events", "render_job_repository", "render_job_store",
        "render_observers", "render_reporting", "runtime_binaries", "runtime_checks",
        "tts_provider", "validate_plain_script", "voice_catalog", "__init__", "__main__"
      ],
      "internal_prefixes": ["audio.adapters", "audio.models", "audio.pipeline", "audio.services"],
      "deprecated_public_modules": []
    },
    "video": {
      "stable_public_modules": [
        "video", "video.__main__", "video.app_api", "video.cli", "video.cli_entry",
        "video.gui_entry", "video.gui", "video.make_video_from_audio"
      ],
      "allowed_root_modules": [
        "app_api", "asset_profile_utils", "cli", "cli_entry", "cli_utils", "command_builders",
        "config", "error_handling", "exceptions", "ffmpeg_runner", "gui_entry", "logging_utils",
        "make_video_from_audio", "paths", "render_slideshow", "render_static", "runtime_tools",
        "run_history", "slideshow_concat", "subtitle_filters", "validation", "__init__", "__main__"
      ],
      "internal_prefixes": ["video.adapters", "video.models", "video.pipeline", "video.services"],
      "deprecated_public_modules": []
    }
  },
  "dependency_direction": {"audio": [], "video": []},
  "rules": {
    "forbid_cross_package_imports_unless_allowed": true,
    "ignore_tests_for_dependency_direction": true,
    "ignore_same_package_imports": true
  }
}
